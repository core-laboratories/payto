{
	"name": "payto",
	"version": "2.1.8",
	"description": "Decentralized transfer of assets.",
	"author": "CORE Labs",
	"license": "CORE",
	"bugs": {
		"url": "https://github.com/core-laboratories/Payto/issues"
	},
	"homepage": "https://github.com/core-laboratories/Payto#readme",
	"type": "module",
	"scripts": {
		"clear-cache": "rm -rf node_modules/.vite/",
		"dev": "npm run clear-cache && vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test:wallet": "vitest --run src/lib/paypass/generation.test.ts src/lib/payqr/pass-api.test.ts",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"typesafe-i18n": "typesafe-i18n",
		"i18n:extract": "typesafe-i18n --no-watch",
		"i18n:watch": "typesafe-i18n"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260916.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/cookie": "^1.0.0",
		"@types/open-location-code": "^1.0.1",
		"eslint": "^10.10.0",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"wrangler": "^4.132.0"
	},
	"dependencies": {
		"@blockchainhub/blo": "^1.2.7",
		"@blockchainhub/ican": "^0.4.3",
		"@bwip-js/generic": "^4.11.4",
		"@neoconfetti/svelte": "^2.2.2",
		"@supabase/supabase-js": "^2.116.0",
		"@sveltejs/kit": "^2.70.3",
		"@tailwindcss/forms": "^0.5.11",
		"@types/node-forge": "^1.3.14",
		"@types/qrcode": "^1.5.6",
		"blockchain-wallet-validator": "^1.2.1",
		"device-sherlock": "^0.2.1",
		"exchange-rounding": "^1.1.8",
		"jose": "^6.2.12",
		"jszip": "^3.10.2",
		"lucide-svelte": "^1.0.1",
		"node-forge": "^1.4.0",
		"open-location-code": "github:google/open-location-code#main",
		"payto-rl": "^1.1.6",
		"qrcode": "^1.5.4",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5",
		"svelte-transition": "^0.0.17",
		"tailwindcss": "^4.3.3",
		"tailwindcss-logical": "^5.0.0",
		"typesafe-i18n": "^5.27.1",
		"zod": "^4.6.5"
	},
	"engines": {
		"node": ">=22"
	}
}
