{
	"name": "payto",
	"version": "2.1.10",
	"description": "Decentralized transfer of assets.",
	"author": "CORE Labs",
	"license": "CORE",
	"bugs": {
		"url": "https://github.com/core-laboratories/Payto/issues"
	},
	"homepage": "https://github.com/core-laboratories/Payto#readme",
	"type": "module",
	"scripts": {
		"clear-cache": "rm -rf node_modules/.vite/",
		"dev": "npm run clear-cache && vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test:wallet": "vitest --run src/lib/paypass/generation.test.ts src/lib/payqr/pass-api.test.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"typesafe-i18n": "typesafe-i18n",
		"i18n:extract": "typesafe-i18n --no-watch",
		"i18n:watch": "typesafe-i18n",
		"tsc:native": "node node_modules/@typescript/native/bin/tsc"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261112.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/cookie": "^1.0.0",
		"@types/open-location-code": "^1.0.1",
		"eslint": "^10.14.0",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"tslib": "^2.9.1",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.160.1",
		"@typescript/native": "npm:typescript@~7.0.2"
	},
	"dependencies": {
		"@blockchainhub/blo": "^1.2.7",
		"@blockchainhub/ican": "^0.4.3",
		"@bwip-js/generic": "^4.11.4",
		"@neoconfetti/svelte": "^2.2.2",
		"@supabase/supabase-js": "^2.119.0",
		"@tailwindcss/forms": "^0.5.11",
		"@types/node-forge": "^1.3.14",
		"@types/qrcode": "^1.5.6",
		"blockchain-wallet-validator": "^1.2.1",
		"device-sherlock": "^0.2.1",
		"exchange-rounding": "^1.1.9",
		"jose": "^6.2.17",
		"jszip": "^3.10.2",
		"lucide-svelte": "^1.0.1",
		"node-forge": "^1.4.3",
		"open-location-code": "github:google/open-location-code#main",
		"payto-rl": "^1.1.9",
		"qrcode": "^1.5.4",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-preprocess": "^6.0.5",
		"svelte-transition": "^0.0.17",
		"tailwindcss": "^4.3.5",
		"tailwindcss-logical": "^5.0.0",
		"typesafe-i18n": "^5.27.1",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#i18n": "./src/i18n/index.ts",
		"#i18n/*": "./src/i18n/*.ts"
	}
}
